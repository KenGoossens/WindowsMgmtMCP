{
  "name": "windows-mcp",
  "version": "0.1.0",
  "description": "The most sophisticated Windows, Cloud PC & cross-cloud workspace management MCP server.",
  "type": "module",
  "bin": {
    "windows-mcp": "dist/index.js",
    "windows-mcp-agent": "dist/agentRuntime/main.js",
    "windows-mcp-webui": "dist/webui/main.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --transport http",
    "start:agent": "node dist/agentRuntime/main.js",
    "start:webui": "node dist/webui/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows",
    "windows-365",
    "cloud-pc",
    "powershell",
    "management"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-workspaces": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@azure/arm-desktopvirtualization": "^1.2.0",
    "@azure/identity": "^4.5.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "pino": "^9.5.0",
    "ssh2": "^1.16.0",
    "undici": "^6.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ssh2": "^1.15.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  }
}
