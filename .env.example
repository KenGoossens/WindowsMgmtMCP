# ── Transport ───────────────────────────────────────────────────────────────
# stdio | http
MCP_TRANSPORT=stdio
# HTTP transport bind address (kept on loopback by default for safety)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
# REQUIRED when MCP_TRANSPORT=http. Bearer token clients must present.
MCP_HTTP_TOKEN=
# bearer | oauth (oauth is a later-phase, P-SaaS option)
MCP_AUTH_MODE=bearer
# Enable per-tenant credential resolution (later phase)
MCP_MULTI_TENANT=false
# Comma-separated allow-list of tool names. Empty = all tools enabled.
# e.g. cloudpc_list,cloudpc_get,system_info
MCP_TOOL_ALLOWLIST=

# ── PowerShell engine ─────────────────────────────────────────────────────────
# pwsh | powershell.exe  (auto-detected when empty: prefers pwsh, falls back to 5.1)
PS_EXECUTABLE=
PS_DEFAULT_TIMEOUT_MS=60000

# ── Microsoft Graph (Windows 365 Cloud PC provider) ──────────────────────────
# app | delegated
GRAPH_AUTH_MODE=app
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Required only for GRAPH_AUTH_MODE=app
GRAPH_CLIENT_SECRET=

# ── Observability ─────────────────────────────────────────────────────────────
AUDIT_LOG_PATH=./logs/audit.log
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Real-time reporting & telemetry (P-Report) ───────────────────────────────
# Enable the background telemetry collector (history + alert evaluation).
# Point-in-time `report_snapshot` works regardless of this flag.
REPORTING_ENABLED=true
# Per-provider telemetry collection cadence (ms).
REPORTING_POLL_INTERVAL_MS=15000
# How long to retain collected samples (minutes).
REPORTING_RETENTION_MINUTES=360
# Hard cap on total in-memory samples (oldest evicted first).
REPORTING_MAX_SAMPLES=50000

# ── Remote Windows (P2 · WinRM / SSH) ────────────────────────────────────────
# Inline JSON array of remote targets, OR point REMOTE_TARGETS_PATH at a JSON file.
# Each target: { "id", "host", "method": "winrm"|"ssh", "port"?, "username"?,
#   "passwordEnv"? (name of an env var holding the password), "privateKeyPath"? (ssh),
#   "useSsl"? (winrm https) }. Passwords are referenced by env-var NAME, never inlined.
# Example:
# REMOTE_TARGETS=[{"id":"web01","host":"10.0.0.5","method":"winrm","username":"DOMAIN\\admin","passwordEnv":"WEB01_PWD"}]
REMOTE_TARGETS=
REMOTE_TARGETS_PATH=
# Default per-call timeout for remote execution (ms).
REMOTE_DEFAULT_TIMEOUT_MS=90000

# ── AWS WorkSpaces (P3 · VDI/DaaS · cross-cloud failover target) ──────────────
# Enables the AWS WorkSpaces provider when AWS_REGION is set. Credentials use the
# standard AWS chain: explicit keys below, OR a named profile, OR an IAM role.
AWS_REGION=
# Optional: scope provisioning to a WorkSpaces directory.
AWS_WORKSPACES_DIRECTORY_ID=
# Option 1 — explicit credentials (else profile / role / env are used):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Option 2 — a named profile from your AWS config/credentials file:
AWS_PROFILE=

# ── Azure Virtual Desktop (P3 · VDI) ─────────────────────────────────────────
# Enables the AVD provider when AVD_SUBSCRIPTION_ID + AVD_RESOURCE_GROUP are set.
# Reuses the GRAPH_* Entra app credentials (scoped to Azure Resource Manager),
# so one app registration can manage both Windows 365 and AVD.
AVD_SUBSCRIPTION_ID=
AVD_RESOURCE_GROUP=

# ── Citrix DaaS (P3 · DaaS) ──────────────────────────────────────────────────
# Enables the Citrix provider when CITRIX_CUSTOMER_ID + CITRIX_CLIENT_ID/SECRET are set.
# API base defaults to https://api.cloud.com (use a region host if required).
CITRIX_API_BASE=https://api.cloud.com
CITRIX_CUSTOMER_ID=
CITRIX_CLIENT_ID=
CITRIX_CLIENT_SECRET=

# ── Omnissa Horizon (P3 · VDI) ───────────────────────────────────────────────
# Enables the Horizon provider when HORIZON_API_BASE + credentials are set.
# API base is the Connection Server, e.g. https://horizon.example.com
HORIZON_API_BASE=
HORIZON_DOMAIN=
HORIZON_USERNAME=
HORIZON_PASSWORD=
# Set true ONLY for lab Connection Servers with self-signed certs (insecure).
HORIZON_INSECURE_TLS=false

# ── State & settings portability (P-State) ───────────────────────────────────
# Where encrypted StateBundles are stored (a local directory for the MVP store).
STATE_STORE_URI=./state
# REQUIRED to capture/restore state: a secret used to derive the at-rest
# encryption key (AES-256-GCM). Keep this out of source control.
STATE_ENCRYPTION_KEY=
# StateBundle retention window in days (expired bundles are purged).
STATE_RETENTION_DAYS=30

# ── Migration orchestration (P-Migrate) ──────────────────────────────────────
# Keep the migration source intact until the target is verified (reversibility).
# Migration tools require the state subsystem (STATE_ENCRYPTION_KEY) to be enabled.
MIGRATION_RETAIN_SOURCE=true

# ── Cross-cloud continuity & failover (P-Failover) ───────────────────────────
# Default primary / secondary substrates for failover (provider ids), e.g.
# windows365 / awsworkspaces, or citrix / horizon. Failover tools also accept
# explicit per-call providers; these are the defaults. Requires the state
# subsystem (STATE_ENCRYPTION_KEY) for state rehydration on the target.
CONTINUITY_PRIMARY=
CONTINUITY_SECONDARY=
# manual = operator-initiated (confirm-gated); policy = may auto-trigger on health.
FAILOVER_MODE=manual

# ── Client troubleshooter agent (P-Agent) ────────────────────────────────────
# Enable the outbound-agent broker on the HTTP host (requires MCP_TRANSPORT=http).
AGENT_BROKER_ENABLED=false
# Shared secret an agent must present to enroll. MVP trust model: enrollment
# token + attestation claim (production hardening: mTLS + hardware attestation).
AGENT_ENROLLMENT_TOKEN=
# Autonomy ceiling the server allows any agent to act at: L0 observe, L1 suggest,
# L2 confirm, L3 autonomous (self-verifying + auto-rollback).
AGENT_MAX_AUTONOMY=L1
# Seconds without a heartbeat before an agent is marked stale.
AGENT_STALE_SECONDS=90

# ── Agent runtime (the outbound process — set on the ENDPOINT, not the server) ─
# The broker URL the agent dials out to, e.g. https://mcp.example.com
AGENT_BROKER_URL=
# The agent's identity; AGENT_ENROLLMENT_TOKEN (above) is reused to enroll.
AGENT_ID=

# ── Tenant onboarding (P-SaaS · access provisioning) ─────────────────────────
# Public, externally reachable base URL of this server, used to build the OAuth
# admin-consent redirect (e.g. https://mcp.example.com). The consent callback is
# served at {ONBOARDING_PUBLIC_URL}/onboarding/callback.
ONBOARDING_PUBLIC_URL=
